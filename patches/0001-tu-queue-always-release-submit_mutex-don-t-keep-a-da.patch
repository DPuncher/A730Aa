From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: a730 patches <build@example.invalid>
Date: Fri, 13 Nov 2026 15:21:35 +0300
Subject: [PATCH 1/3] tu/queue: always release submit_mutex, don't keep a
 dangling vis stream BO

queue_submit() takes device->submit_mutex early but several error paths
returned (or jumped to "out") without releasing it:

 - tu_insert_dynamic_cmdbufs() failure
 - tu_submit_create() failure (which also returned VK_SUCCESS)
 - resolve_vis_stream_patchpoints() failure
 - resolve_cb_control_patchpoints() failure

queue_submit_sparse() had the same problem when tu_submit_create() fails.

Any later submit (or a kgsl wait on an unsignaled syncobj, which takes the
same mutex) then blocks forever on a mutex that nobody will ever unlock.
resolve_vis_stream_patchpoints() can fail with OOM when the visibility
stream BO has to grow, which is exactly what heavy workloads trigger.

Additionally, when growing the visibility stream BO the old BO is released
before tu_bo_init_new(), which does not touch its output on failure. The
device was left pointing at the released BO while vis_stream_size already
had the new, larger value, so the next submit would skip the reallocation
and patch command streams with a dangling iova (GPU fault). Clear the
pointer so the allocation is retried instead.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01569Z15uz61HA7LZqA6PJAh
---
 src/freedreno/vulkan/tu_queue.cc | 29 +++++++++++++++++++++++------
 1 file changed, 23 insertions(+), 6 deletions(-)

diff --git a/src/freedreno/vulkan/tu_queue.cc b/src/freedreno/vulkan/tu_queue.cc
index 3e6cd0af..c899d052 100644
--- a/src/freedreno/vulkan/tu_queue.cc
+++ b/src/freedreno/vulkan/tu_queue.cc
@@ -193,8 +193,14 @@ resolve_vis_stream_patchpoints(struct tu_queue *queue,
       dev->vis_stream_count = MAX2(dev->vis_stream_count,
                                    min_vis_stream_count);
       dev->vis_stream_size = MAX2(dev->vis_stream_size, max_size);
-      if (dev->vis_stream_bo)
+      if (dev->vis_stream_bo) {
          tu_bo_finish(dev, dev->vis_stream_bo);
+         /* tu_bo_init_new() leaves its output untouched on failure. Without
+          * this the next submit would pick up the BO that was just released
+          * and patch command streams with a dangling iova.
+          */
+         dev->vis_stream_bo = NULL;
+      }
       result = tu_bo_init_new(dev, &dev->vk.base, &dev->vis_stream_bo,
                               dev->vis_stream_size * dev->vis_stream_count, 
                               TU_BO_ALLOC_INTERNAL_RESOURCE,
@@ -345,8 +351,10 @@ queue_submit_sparse(struct vk_queue *_queue, struct vk_queue_submit *vk_submit)
    pthread_mutex_lock(&device->submit_mutex);
 
    void *submit = tu_submit_create(device);
-   if (!submit)
+   if (!submit) {
+      pthread_mutex_unlock(&device->submit_mutex);
       return VK_ERROR_OUT_OF_HOST_MEMORY;
+   }
 
    for (uint32_t i = 0; i < vk_submit->buffer_bind_count; i++) {
       const VkSparseBufferMemoryBindInfo *bind = &vk_submit->buffer_binds[i];
@@ -441,8 +449,10 @@ queue_submit(struct vk_queue *_queue, struct vk_queue_submit *vk_submit)
 
    VkResult result =
       tu_insert_dynamic_cmdbufs(device, &cmd_buffers, &cmdbuf_count);
-   if (result != VK_SUCCESS)
+   if (result != VK_SUCCESS) {
+      pthread_mutex_unlock(&device->submit_mutex);
       return result;
+   }
 
    bool has_trace_points = false;
    static_assert(offsetof(struct tu_cmd_buffer, vk) == 0,
@@ -455,19 +465,26 @@ queue_submit(struct vk_queue *_queue, struct vk_queue_submit *vk_submit)
    struct tu_u_trace_submission_data *u_trace_submission_data = NULL;
 
    void *submit = tu_submit_create(device);
-   if (!submit)
+   if (!submit) {
+      pthread_mutex_unlock(&device->submit_mutex);
+      result = VK_ERROR_OUT_OF_HOST_MEMORY;
       goto fail_create_submit;
+   }
 
    result = resolve_vis_stream_patchpoints(queue, submit, &dump_cmds,
                                            cmd_buffers, cmdbuf_count);
-   if (result != VK_SUCCESS)
+   if (result != VK_SUCCESS) {
+      pthread_mutex_unlock(&device->submit_mutex);
       goto out;
+   }
 
    result = resolve_cb_control_patchpoints(queue, submit, &dump_cmds,
                                            cmd_buffers, cmdbuf_count);
 
-   if (result != VK_SUCCESS)
+   if (result != VK_SUCCESS) {
+      pthread_mutex_unlock(&device->submit_mutex);
       goto out;
+   }
 
    if (has_trace_points) {
       tu_u_trace_submission_data_create(
