From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: a730 patches <build@example.invalid>
Date: Fri, 13 Nov 2026 15:22:27 +0300
Subject: [PATCH 2/3] tu/kgsl: don't turn wait failures into timeouts

The timestamp wait, the sync fd wait and the wait-any path all did
"assert(errno == ETIME[DOUT]); return VK_TIMEOUT;" for every failure.
asserts are compiled out of release builds, so a failed wait (for example
EPROTO after a GPU fault, see mesa#11204) was reported to the application
as a plain timeout. An application that waits with an infinite timeout and
simply retries on VK_TIMEOUT then spins forever without ever learning that
the GPU is gone, and vkGetFenceStatus()/vkGetSemaphoreCounterValue() keep
reporting "not ready".

 - wait_timestamp_safe(): log the unexpected errno, ask the kernel whether
   the GPU was reset (KGSL_PROP_GPU_RESET_STAT) and, if the failure persists
   for a few seconds, mark the device lost. Polls (timeout 0) keep returning
   VK_TIMEOUT so nothing changes for kernels that return something unusual on
   a poll.
 - sync fd wait: only ETIME is a timeout, a fence in an error state or an
   invalid fd is device loss.
 - kgsl_syncobj_wait_any(): the poll() result was interpreted the wrong way
   round: a signaled fence (ret > 0) was reported as VK_TIMEOUT and an expired
   timeout (ret == 0) as VK_SUCCESS.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01569Z15uz61HA7LZqA6PJAh
---
 src/freedreno/vulkan/tu_knl_kgsl.cc | 103 +++++++++++++++++++++++-----
 1 file changed, 85 insertions(+), 18 deletions(-)

diff --git a/src/freedreno/vulkan/tu_knl_kgsl.cc b/src/freedreno/vulkan/tu_knl_kgsl.cc
index 44af0c22..eb83a7f9 100644
--- a/src/freedreno/vulkan/tu_knl_kgsl.cc
+++ b/src/freedreno/vulkan/tu_knl_kgsl.cc
@@ -812,11 +812,29 @@ get_relative_ms(uint64_t abs_timeout_ns)
    return abs_timeout_ms - cur_time_ms;
 }
 
+static VkResult kgsl_device_check_status(struct tu_device *device);
+
+/* A blocking wait that keeps failing for this long without the kernel
+ * reporting a GPU reset is given up on and the device is declared lost.
+ */
+#define KGSL_WAIT_FAIL_NS (3ull * 1000 * 1000 * 1000)
+
+static void
+kgsl_log_unexpected_wait_errno(const char *what, int err)
+{
+   /* Don't flood the log if a kernel returns something unusual on every
+    * single poll.
+    */
+   static int count;
+   if (p_atomic_inc_return(&count) <= 8)
+      mesa_loge("KGSL: %s failed: %s (errno %d)", what, strerror(err), err);
+}
+
 /* safe_ioctl is not enough as restarted waits would not adjust the timeout
  * which could lead to waiting substantially longer than requested
  */
 static VkResult
-wait_timestamp_safe(int fd,
+wait_timestamp_safe(struct tu_device *device,
                     unsigned int context_id,
                     unsigned int timestamp,
                     uint64_t abs_timeout_ns)
@@ -826,11 +844,16 @@ wait_timestamp_safe(int fd,
       .timestamp = timestamp,
       .timeout = get_relative_ms(abs_timeout_ns),
    };
+   uint64_t first_failure_ns = 0;
 
    while (true) {
-      int ret = ioctl(fd, IOCTL_KGSL_DEVICE_WAITTIMESTAMP_CTXTID, &wait);
+      int ret = ioctl(device->fd, IOCTL_KGSL_DEVICE_WAITTIMESTAMP_CTXTID,
+                      &wait);
 
-      if (ret == -1 && (errno == EINTR || errno == EAGAIN)) {
+      if (ret == 0)
+         return VK_SUCCESS;
+
+      if (errno == EINTR || errno == EAGAIN) {
          int timeout_ms = get_relative_ms(abs_timeout_ns);
 
          /* update timeout to consider time that has passed since the start */
@@ -838,12 +861,40 @@ wait_timestamp_safe(int fd,
             return VK_TIMEOUT;
 
          wait.timeout = timeout_ms;
-      } else if (ret == -1) {
-         assert(errno == ETIMEDOUT);
+         continue;
+      }
+
+      if (errno == ETIMEDOUT)
          return VK_TIMEOUT;
-      } else {
-         return VK_SUCCESS;
+
+      /* Anything else (e.g. EPROTO after a GPU fault) is not a timeout.
+       * This used to be an assert(), which is compiled out of release builds,
+       * followed by a plain VK_TIMEOUT. A caller waiting with an infinite
+       * timeout then just calls us again and spins forever instead of
+       * learning that the GPU is gone.
+       */
+      int err = errno;
+      kgsl_log_unexpected_wait_errno("timestamp wait", err);
+
+      /* Keep polls cheap and keep their old meaning ("not signaled yet"). */
+      if (get_relative_ms(abs_timeout_ns) == 0)
+         return VK_TIMEOUT;
+
+      VkResult status = kgsl_device_check_status(device);
+      if (status != VK_SUCCESS)
+         return status;
+
+      uint64_t now_ns = os_time_get_nano();
+      if (first_failure_ns == 0) {
+         first_failure_ns = now_ns;
+      } else if (now_ns - first_failure_ns >= KGSL_WAIT_FAIL_NS) {
+         return vk_device_set_lost(&device->vk,
+                                   "KGSL timestamp wait keeps failing: %s",
+                                   strerror(err));
       }
+
+      usleep(1000);
+      wait.timeout = get_relative_ms(abs_timeout_ns);
    }
 }
 
@@ -853,7 +904,7 @@ kgsl_queue_wait_fence(struct tu_queue *queue, uint32_t fence,
 {
    uint64_t abs_timeout_ns = os_time_get_nano() + timeout_ns;
 
-   return wait_timestamp_safe(queue->device->fd, queue->msm_queue_id,
+   return wait_timestamp_safe(queue->device, queue->msm_queue_id,
                               fence, abs_timeout_ns);
 }
 
@@ -902,18 +953,23 @@ kgsl_syncobj_wait(struct tu_device *device,
       return VK_TIMEOUT;
 
    case KGSL_SYNCOBJ_STATE_TS: {
-      return wait_timestamp_safe(device->fd, s->queue->msm_queue_id,
+      return wait_timestamp_safe(device, s->queue->msm_queue_id,
                                  s->timestamp, abs_timeout_ns);
    }
 
    case KGSL_SYNCOBJ_STATE_FD: {
       int ret = sync_wait(s->fd, get_relative_ms(abs_timeout_ns));
-      if (ret) {
-         assert(errno == ETIME);
-         return VK_TIMEOUT;
-      } else {
+      if (ret == 0)
          return VK_SUCCESS;
-      }
+
+      if (errno == ETIME)
+         return VK_TIMEOUT;
+
+      /* The fence is in an error state (POLLERR) or is not valid at all. */
+      int err = errno;
+      kgsl_log_unexpected_wait_errno("sync fd wait", err);
+      return vk_device_set_lost(&device->vk, "KGSL sync fd wait failed: %s",
+                                strerror(err));
    }
 
    default:
@@ -1000,7 +1056,7 @@ kgsl_syncobj_wait_any(struct tu_device* device, struct kgsl_syncobj **syncobjs,
    }
 
    if (u_vector_length(&poll_fds) == 0) {
-      result = wait_timestamp_safe(device->fd, queue->msm_queue_id,
+      result = wait_timestamp_safe(device, queue->msm_queue_id,
                                    lowest_timestamp, MIN2(abs_timeout_ns, INT64_MAX));
    } else {
       int ret, i;
@@ -1024,14 +1080,25 @@ kgsl_syncobj_wait_any(struct tu_device* device, struct kgsl_syncobj **syncobjs,
          }
       } while (ret == -1 && (errno == EINTR || errno == EAGAIN));
 
+      /* close() may clobber errno */
+      int poll_errno = errno;
+
       for (uint32_t i = 0; i < fds_count - num_fds; i++)
          close(fds[i].fd);
 
-      if (ret != 0) {
-         assert(errno == ETIME);
+      /* poll() returns the number of signaled fds, 0 on timeout and -1 on
+       * error (including the POLLERR/POLLNVAL case turned into EINVAL above).
+       * This used to treat "signaled" as a timeout and "timeout" as success.
+       */
+      if (ret > 0) {
+         result = VK_SUCCESS;
+      } else if (ret == 0) {
          result = VK_TIMEOUT;
       } else {
-         result = VK_SUCCESS;
+         kgsl_log_unexpected_wait_errno("wait-any poll", poll_errno);
+         result = vk_device_set_lost(&device->vk,
+                                     "KGSL wait-any failed: %s",
+                                     strerror(poll_errno));
       }
    }
 
